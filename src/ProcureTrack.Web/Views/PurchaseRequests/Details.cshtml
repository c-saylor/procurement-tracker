@model PurchaseRequestDetailsViewModel
@{
    var r = Model.Request;
    ViewData["Title"] = r.RequestNumber;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Purchase Requests</a></li>
        <li class="breadcrumb-item active" aria-current="page">@r.RequestNumber</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@r.Title</h1>
        <div class="text-body-secondary">
            @r.RequestNumber &middot; <partial name="_StatusBadge" model="r.Status" />
        </div>
    </div>
    @if (Model.CanEdit)
    {
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-outline-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-outline-danger">Delete</a>
        </div>
    }
</div>

@if (r.Status != RequestStatus.Pending)
{
    <div class="alert alert-secondary" role="status">
        This request has been @r.Status.ToString().ToLowerInvariant() and is now closed to editing.
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header fw-semibold">Request details</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@r.Department.Name</dd>

                    <dt class="col-sm-4">Vendor</dt>
                    <dd class="col-sm-8">
                        @r.Vendor.Name
                        @if (!r.Vendor.IsActive)
                        {
                            <span class="badge text-bg-secondary ms-1">Inactive vendor</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Amount</dt>
                    <dd class="col-sm-8">@r.Amount.ToString("C")</dd>

                    <dt class="col-sm-4">Requested by</dt>
                    <dd class="col-sm-8">@r.RequestedBy</dd>

                    <dt class="col-sm-4">Submitted</dt>
                    <dd class="col-sm-8">@r.SubmittedDate.ToString("MMM d, yyyy h:mm tt") UTC</dd>

                    <dt class="col-sm-4">Required by</dt>
                    <dd class="col-sm-8">@r.RequiredByDate.ToString("MMM d, yyyy")</dd>

                    @if (!string.IsNullOrWhiteSpace(r.Description))
                    {
                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8 text-preline">@r.Description</dd>
                    }

                    <dt class="col-sm-4">Business justification</dt>
                    <dd class="col-sm-8 text-preline mb-0">@r.BusinessJustification</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
                @if (Model.CanDecide)
        {
            <div class="card border-primary mb-3">
                <div class="card-header fw-semibold">Record a decision</div>
                <div class="card-body">
                    <p class="small text-body-secondary mb-3">Deciding as <strong>@User.Identity?.Name</strong></p>

                    <form asp-action="Decide" asp-route-id="@r.Id" method="post" id="decision-form" novalidate
                          data-request-summary="@($"{r.RequestNumber} ({r.Amount.ToString("C")})")">
                        <input type="hidden" asp-for="Decision.RowVersion" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <fieldset class="mb-3">
                            <legend class="form-label fs-6 mb-1">Decision</legend>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Decision.Action"
                                       value="@ApprovalAction.Approved" id="decision-approve" />
                                <label class="form-check-label" for="decision-approve">Approve</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Decision.Action"
                                       value="@ApprovalAction.Rejected" id="decision-reject" />
                                <label class="form-check-label" for="decision-reject">Reject</label>
                            </div>
                            <span asp-validation-for="Decision.Action" class="text-danger small"></span>
                        </fieldset>

                        <div class="mb-3" id="decision-notes-group">
                            <label asp-for="Decision.Notes" class="form-label"></label>
                            <textarea asp-for="Decision.Notes" class="form-control" rows="3" aria-describedby="decisionNotesHelp"></textarea>
                            <div id="decisionNotesHelp" class="form-text">Optional for approval. Required when rejecting.</div>
                            <span asp-validation-for="Decision.Notes" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Submit decision</button>
                    </form>
                </div>
            </div>

            @* Confirmation dialog, driven by jQuery. Text is set with .text() so nothing is parsed as HTML. *@
            <div class="modal fade" id="decision-confirm-modal" tabindex="-1" aria-labelledby="decision-confirm-title" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="decision-confirm-title">Confirm decision</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
                        </div>
                        <div class="modal-body" id="decision-confirm-body"></div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-success" id="decision-confirm-button">Confirm</button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (r.Status == RequestStatus.Pending && Model.IsOwnRequest && User.IsInRole(AppRoles.Approver))
        {
            <div class="alert alert-info small" role="note">
                You submitted this request, so a different approver must decide it (separation of duties).
            </div>
        }

        <div class="card">
            <div class="card-header fw-semibold">Approval history</div>
            @if (r.ApprovalRecords.Count == 0)
            {
                <div class="card-body text-body-secondary">
                    No decision recorded yet. This request is awaiting review.
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var a in r.ApprovalRecords.OrderByDescending(a => a.ActedAt))
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between gap-2">
                                <strong>@a.Action</strong>
                                <small class="text-body-secondary text-nowrap">@a.ActedAt.ToString("MMM d, yyyy h:mm tt") UTC</small>
                            </div>
                            <div class="small">by @a.ActedBy</div>
                            @if (!string.IsNullOrWhiteSpace(a.Notes))
                            {
                                <p class="mb-0 mt-1 small text-preline">@a.Notes</p>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/decision-form.js" asp-append-version="true"></script>
}