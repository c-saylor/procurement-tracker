@model PurchaseRequestIndexViewModel
@{
    ViewData["Title"] = "Purchase Requests";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Purchase Requests</h1>
    @if (User.IsInRole(AppRoles.Requester))
    {
        <a asp-action="Create" class="btn btn-primary">New request</a>
    }
</div>

<form method="get" asp-action="Index" id="request-filter-form" class="card card-body mb-3"
      role="search" aria-label="Filter purchase requests">
    <div class="row g-3">
        <div class="col-md-6 col-lg-4">
            <label asp-for="Filter.Search" class="form-label"></label>
            <input asp-for="Filter.Search" type="search" class="form-control" placeholder="Title or requester" />
        </div>
        <div class="col-md-6 col-lg-4">
            <label asp-for="Filter.DepartmentId" class="form-label"></label>
            <select asp-for="Filter.DepartmentId" asp-items="Model.Departments" class="form-select">
                <option value="">All departments</option>
            </select>
        </div>
        <div class="col-md-6 col-lg-4">
            <label asp-for="Filter.VendorId" class="form-label"></label>
            <select asp-for="Filter.VendorId" asp-items="Model.Vendors" class="form-select">
                <option value="">All vendors</option>
            </select>
        </div>
        <div class="col-md-6 col-lg-4">
            <label asp-for="Filter.Status" class="form-label"></label>
            <select asp-for="Filter.Status" asp-items="Model.Statuses" class="form-select">
                <option value="">All statuses</option>
            </select>
        </div>
        <div class="col-md-6 col-lg-4">
            <label asp-for="Filter.SubmittedFrom" class="form-label"></label>
            <input asp-for="Filter.SubmittedFrom" type="date" class="form-control" />
        </div>
        <div class="col-md-6 col-lg-4">
            <label asp-for="Filter.SubmittedTo" class="form-label"></label>
            <input asp-for="Filter.SubmittedTo" type="date" class="form-control" aria-describedby="date-range-error" />
            <span asp-validation-for="Filter.SubmittedTo" class="text-danger small"></span>
            <div id="date-range-error" class="text-danger small d-none">
                The end date must be on or after the start date.
            </div>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">Apply filters</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@* Persistent live region: screen readers announce result counts after AJAX updates. *@
<p id="results-status" class="visually-hidden" aria-live="polite"></p>

<div id="request-results-container">
    <partial name="_RequestTable" model="Model" />
</div>

@section Scripts {
    <script src="~/js/request-filters.js" asp-append-version="true"></script>
}