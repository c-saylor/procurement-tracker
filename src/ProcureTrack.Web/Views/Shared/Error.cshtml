@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="h3">Something went wrong</h1>
    <p class="text-body-secondary">
        An unexpected error occurred while processing your request. Technical details are recorded
        in the server log and are not shown here.
    </p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-body-secondary">
            Reference ID: <code>@Model.RequestId</code><br />
            Include this ID if you report the problem so it can be matched to the server log.
        </p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to dashboard</a>
</div>